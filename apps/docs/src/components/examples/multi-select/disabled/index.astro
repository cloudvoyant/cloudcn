---
import Example from '../../../Example.astro';
import ReactMultiSelectDisabled from './react.tsx';
import SvelteMultiSelectDisabled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="disabled" title="Disabled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactMultiSelectDisabled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteMultiSelectDisabled client:load />
  </div>
</Example>
