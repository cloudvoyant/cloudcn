---
import Example from '../../../Example.astro';
import ReactToggleButtonOutline from './react.tsx';
import SvelteToggleButtonOutline from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example title="Outline" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactToggleButtonOutline client:load />
  </div>
  <div data-fw="svelte">
    <SvelteToggleButtonOutline client:load />
  </div>
</Example>
