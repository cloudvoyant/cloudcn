---
import Example from '../../../Example.astro';
import ReactSwitchDisabled from './react.tsx';
import SvelteSwitchDisabled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="disabled" title="Disabled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactSwitchDisabled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteSwitchDisabled client:load />
  </div>
</Example>
