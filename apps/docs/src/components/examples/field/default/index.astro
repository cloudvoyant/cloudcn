---
import Example from '../../../Example.astro';
import ReactFieldDefault from './react.tsx';
import SvelteFieldDefault from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example title="Default" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactFieldDefault client:load />
