---
// apps/docs/src/components/examples/code-block/features/index.astro
import Example from '../../../Example.astro';
import ReactCodeBlockFeatures from './react.tsx';
import SvelteCodeBlockFeatures from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="features" title="Line numbers & highlights" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactCodeBlockFeatures client:load />
  </div>
  <div data-fw="svelte">
    <SvelteCodeBlockFeatures client:load />
  </div>
</Example>
