---
import Example from '../../../Example.astro';
import ReactTextareaError from './react.tsx';
import SvelteTextareaError from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="error" title="Validation error" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactTextareaError client:load />
  </div>
  <div data-fw="svelte">
    <SvelteTextareaError client:load />
  </div>
</Example>
