---
import Example from '../../../Example.astro';
import ReactFieldDisabled from './react.tsx';
import SvelteFieldDisabled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="disabled" title="Disabled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactFieldDisabled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteFieldDisabled client:load />
  </div>
</Example>
