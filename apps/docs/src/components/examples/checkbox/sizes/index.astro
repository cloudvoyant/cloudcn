---
import Example from '../../../Example.astro';
import ReactCheckboxSizes from './react.tsx';
import SvelteCheckboxSizes from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="sizes" title="Sizes" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactCheckboxSizes client:load />
  </div>
  <div data-fw="svelte">
    <SvelteCheckboxSizes client:load />
  </div>
</Example>
