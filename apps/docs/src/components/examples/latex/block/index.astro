---
// apps/docs/src/components/examples/latex/block/index.astro
import Example from '../../../Example.astro';
import ReactLaTeXBlock from './react.tsx';
import SvelteLaTeXBlock from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="block" title="Block" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactLaTeXBlock client:load />
  </div>
  <div data-fw="svelte">
    <SvelteLaTeXBlock client:load />
  </div>
</Example>
