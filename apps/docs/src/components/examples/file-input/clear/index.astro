---
import Example from '../../../Example.astro';
import ReactFileInputClear from './react.tsx';
import SvelteFileInputClear from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="clear" title="Clear" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactFileInputClear client:load />
  </div>
  <div data-fw="svelte">
    <SvelteFileInputClear client:load />
  </div>
</Example>
