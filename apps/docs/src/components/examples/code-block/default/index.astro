---
// apps/docs/src/components/examples/code-block/default/index.astro
import Example from '../../../Example.astro';
import ReactCodeBlockDefault from './react.tsx';
import SvelteCodeBlockDefault from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="default" title="Default" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactCodeBlockDefault client:load />
  </div>
  <div data-fw="svelte">
    <SvelteCodeBlockDefault client:load />
  </div>
</Example>
