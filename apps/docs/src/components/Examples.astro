---
// apps/docs/src/components/Examples.astro
import Demo from './Demo.astro';

type ComponentName = Parameters<typeof Demo>[0]['component'];
type ExampleName = Parameters<typeof Demo>[0]['example'];

interface Props {
  component?: ComponentName;
  /** The example already shown in the intro — skip it here. */
  exclude?: ExampleName;
}

const { component = 'button', exclude } = Astro.props;

const titles: Record<string, { id: string; title: string }[]> = {
