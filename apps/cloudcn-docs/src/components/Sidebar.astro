---
import { getCollection } from 'astro:content';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const general = (await getCollection('general')).sort((a, b) => a.data.order - b.data.order);
const components = (await getCollection('components')).sort((a, b) => a.data.order - b.data.order);

const layout = components.filter((c) => c.data.group === 'Layout');
const rest = components.filter((c) => c.data.group !== 'Layout');

const groups = [
  { label: 'General', section: 'general', items: general },
  { label: 'Layout', section: 'components', items: layout },
  { label: 'Components', section: 'components', items: rest },
];
---

<nav class="flex flex-col gap-8 text-sm" aria-label="Docs navigation">
  {groups.map((group) =>
    group.items.length > 0 ? (
      <div>
        <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{group.label}</p>
        <ul class="flex flex-col gap-0.5">
          {group.items.map((entry) => {
            const href = `/${group.section}/${entry.id}`;
            const active = currentPath === href;
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    'block rounded-md px-3 py-1.5 font-medium transition-colors',
                    active ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:bg-accent/60 hover:text-foreground',
                  ]}
                >
                  {entry.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ) : null,
  )}
</nav>
