---
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import Footer from '../components/Footer.astro';
import MobileSidebar from '../components/MobileSidebar.astro';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  headings?: TocHeading[];
}

const {
  title = 'wicn',
  description,
  currentPath = import.meta.env.BASE_URL,
  headings = [] }
= Astro.props;
---

<!doctype html>
<html lang="en" data-framework="react">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon-light.svg`} data-favicon="light" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon-dark.svg`} data-favicon="dark" />
    <link rel="alternate icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        try {
          var framework = localStorage.getItem('wicn:framework');
          if (framework === 'svelte' || framework === 'react') {
            document.documentElement.dataset.framework = framework;
          }
          // Restore the theme before first paint to avoid a flash.
          var root = document.documentElement;
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          var mode = localStorage.getItem('wicn:color-mode') || 'system';
          var dark = mode === 'dark' || (mode === 'system' && mq.matches);
          if (dark) root.classList.add('dark');
          var theme = localStorage.getItem('wicn:theme');
          // Default to the wicn brand theme when nothing is stored. Ignore
          // legacy 'light'/'dark' values left by the old theme toggle.
          if (!theme || theme === 'light' || theme === 'dark') theme = 'wicn';
          {
            var toRemove = [];
            for (var i = 0; i < root.classList.length; i++) {
              if (root.classList[i].indexOf('theme-') === 0) toRemove.push(root.classList[i]);
            }
            for (var j = 0; j < toRemove.length; j++) root.classList.remove(toRemove[j]);
            root.classList.add('theme-' + theme);
          }
          // Show the theme-appropriate favicon: `dark` class on <html> selects it.
          var favicons = document.querySelectorAll('link[rel="icon"][data-favicon]');
          var applyFavicon = function (isDark) {
            for (var k = 0; k < favicons.length; k++) {
              favicons[k].media = isDark ? 'not all' : 'all';
              favicons[k].setAttribute('media', isDark ? '(prefers-color-scheme: dark)' : '(prefers-color-scheme: light)');
            }
          };
          applyFavicon(dark);
          // Keep the favicon in sync when the theme toggles at runtime.
          var faviconObserver = new MutationObserver(function () {
            applyFavicon(document.documentElement.classList.contains('dark'));
          });
          faviconObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <TopNav currentPath={currentPath} />
    <div class="flex w-full gap-8">
      <aside class="hidden w-56 shrink-0 py-10 pl-4 lg:block lg:pl-8">
        <div class="sticky top-24">
          <Sidebar currentPath={currentPath} />
        </div>
      </aside>
      <main class="min-w-0 flex-1 py-10">
        <div class="mx-auto w-full max-w-4xl">
          <slot />
        </div>
      </main>
      <Toc headings={headings} />
    </div>
    <Footer />
    <MobileSidebar currentPath={currentPath} />
  </body>
</html>
