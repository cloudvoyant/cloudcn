---
import Example from '../../../Example.astro';
import ReactInputControlled from './react.tsx';
import SvelteInputControlled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="controlled" title="Controlled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactInputControlled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteInputControlled client:load />
  </div>
</Example>
