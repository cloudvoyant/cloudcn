{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cloudvoyant/helix": ["../../libs/helix/src/index.ts"],
      "@cloudvoyant/helix-react": ["../../libs/helix-react/src/index.ts"],
      "@cloudvoyant/helix-svelte": ["../../libs/helix-svelte/src/index.ts"]
    }
  }
}
