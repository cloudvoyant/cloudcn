---
import Example from '../../../Example.astro';
import ReactTextareaSizes from './react.tsx';
import SvelteTextareaSizes from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="sizes" title="Sizes" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactTextareaSizes client:load />
  </div>
  <div data-fw="svelte">
    <SvelteTextareaSizes client:load />
  </div>
</Example>
