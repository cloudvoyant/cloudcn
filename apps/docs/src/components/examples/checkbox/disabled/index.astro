---
import Example from '../../../Example.astro';
import ReactCheckboxDisabled from './react.tsx';
import SvelteCheckboxDisabled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="disabled" title="Disabled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactCheckboxDisabled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteCheckboxDisabled client:load />
  </div>
</Example>
