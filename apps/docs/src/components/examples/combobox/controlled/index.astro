---
import Example from '../../../Example.astro';
import ReactComboboxControlled from './react.tsx';
import SvelteComboboxControlled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="controlled" title="Controlled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactComboboxControlled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteComboboxControlled client:load />
  </div>
</Example>
