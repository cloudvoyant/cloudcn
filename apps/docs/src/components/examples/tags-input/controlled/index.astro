---
import Example from '../../../Example.astro';
import ReactTagsInputControlled from './react.tsx';
import SvelteTagsInputControlled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="controlled" title="Controlled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactTagsInputControlled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteTagsInputControlled client:load />
  </div>
</Example>
