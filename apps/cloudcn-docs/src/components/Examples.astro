---
// apps/cloudcn-docs/src/components/Examples.astro
import Demo from './Demo.astro';

type ComponentName = Parameters<typeof Demo>[0]['component'];
type ExampleName = Parameters<typeof Demo>[0]['example'];

interface Props {
  component?: ComponentName;
  /** The example already shown in the intro — skip it here. */
  exclude?: ExampleName;
}

const { component = 'button', exclude } = Astro.props;

const titles: Record<string, { id: string; title: string }[]> = {
  button: [
    { id: 'outline', title: 'Outline' },
    { id: 'rounded', title: 'Rounded' },
    { id: 'sizes', title: 'Sizes' },
    { id: 'icon', title: 'Icon button' },
    { id: 'with-icon', title: 'With icon' },
    { id: 'disabled', title: 'Disabled' },
  ],
  'toggle-button': [
    { id: 'outline', title: 'Outline' },
    { id: 'icon', title: 'Icon' },
    { id: 'indicator', title: 'Indicator' },
  ],
  badge: [
    { id: 'variants', title: 'Variants' },
    { id: 'colors', title: 'Colors' },
    { id: 'sizes', title: 'Sizes' },
  ],
};
const entries = (titles[component ?? 'button'] ?? []).filter((e) => e.id !== exclude);
---

<div class="flex flex-col gap-10">
  {entries.map((entry) => (
    <section class="flex flex-col gap-3">
      <h3 class="text-lg font-semibold tracking-tight">{entry.title}</h3>
      <Demo component={component} example={entry.id as ExampleName} />
    </section>
  ))}
</div>
