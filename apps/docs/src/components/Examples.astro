---
// apps/docs/src/components/Examples.astro
import Demo from './Demo.astro';
import registry from './examples/registry.json';

type ComponentName = keyof typeof registry;

interface Props {
  component?: ComponentName;
  /** The example already shown in the intro — skip it here. */
  exclude?: string;
}

const { component = 'button', exclude } = Astro.props;

const entries = (registry[component as ComponentName] ?? []).filter((e) => e.id !== exclude);
---

<div class="flex flex-col gap-10">
  {entries.map((entry) => (
    <section class="flex flex-col gap-3">
      <h3 class="text-lg font-semibold tracking-tight">{entry.title}</h3>
      <Demo component={component} example={entry.id} />
    </section>
  ))}
</div>
