const entries = (titles[component ?? 'button'] ?? []).filter((e) => e.id !== exclude);
---

<div class="flex flex-col gap-10">
  {entries.map((entry) => (
    <section class="flex flex-col gap-3">
      <h3 class="text-lg font-semibold tracking-tight">{entry.title}</h3>
      <Demo component={component} example={entry.id as ExampleName} />
    </section>
  ))}
</div>
