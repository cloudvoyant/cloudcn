import SvelteNavbarShrink from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example title="Shrink on scroll" reactCode={reactCode} svelteCode={svelteCode} fullscreen>
  <div data-fw="react">
    <ReactNavbarShrink client:only="react" />
