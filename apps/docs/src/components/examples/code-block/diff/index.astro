---
// apps/docs/src/components/examples/code-block/diff/index.astro
import Example from '../../../Example.astro';
import ReactCodeBlockDiff from './react.tsx';
import SvelteCodeBlockDiff from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="diff" title="Diff" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactCodeBlockDiff client:load />
  </div>
  <div data-fw="svelte">
    <SvelteCodeBlockDiff client:load />
  </div>
</Example>
