{
  "name": "docs",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "vertex-ui docs/demo app — Astro site with React + Svelte component demos",
  "scripts": {
    "predev": "pnpm --filter @cloudvoyant/vertex-ui --filter @cloudvoyant/vertex-react --filter @cloudvoyant/vertex-svelte run build",
    "prebuild": "pnpm --filter @cloudvoyant/vertex-ui --filter @cloudvoyant/vertex-react --filter @cloudvoyant/vertex-svelte run build",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "e2e": "playwright test",
    "test": "vitest run --passWithNoTests",
    "lint": "astro check && eslint \"src/**/*.{ts,tsx,mjs}\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,mjs}\" --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mjs}\""
  },
  "dependencies": {
    "@astrojs/mdx": "catalog:",
    "@astrojs/react": "catalog:",
    "@astrojs/svelte": "catalog:",
    "@cloudvoyant/vertex-ui": "workspace:*",
    "@cloudvoyant/vertex-react": "workspace:*",
    "@cloudvoyant/vertex-svelte": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "lucide-react": "catalog:",
    "lucide-svelte": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "katex": "catalog:",
    "manim-web": "catalog:",
    "mermaid": "catalog:",
    "shadcn": "^4.19.0",
    "shiki": "catalog:",
    "typescript": "catalog:"
  }
}
