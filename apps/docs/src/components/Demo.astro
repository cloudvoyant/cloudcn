---
// apps/docs/src/components/Demo.astro
// Renders a single example card (preview + code).
import Example from './Example.astro';
import ReactRouter from './ReactRouter.tsx';
import SvelteRouter from './SvelteRouter.svelte';

interface Props {
  component?: string;
  example?: string;
}

const { component = 'button', example = 'default' } = Astro.props;

// Read the raw source code for the toggles (this works fine in Astro).
// For the actual execution, we defer to the ReactRouter/SvelteRouter.
const reactRawModules = import.meta.glob('./examples/*/*/react.tsx', { query: '?raw', import: 'default' });
const svelteRawModules = import.meta.glob('./examples/*/*/svelte.svelte', { query: '?raw', import: 'default' });

const reactPath = `./examples/${component}/${example}/react.tsx`;
const sveltePath = `./examples/${component}/${example}/svelte.svelte`;

const reactCode = (await reactRawModules[reactPath]?.()) as string | undefined;
const svelteCode = (await svelteRawModules[sveltePath]?.()) as string | undefined;

const title = example
  .split('-')
  .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
  .join(' ');

const isFullscreen = ['sidebar', 'page', 'layout', 'navbar', 'scroll', 'splitter', 'window'].includes(component);
---

<div class="w-full" data-demo-region>
  <Example 
    id={example} 
    title={title} 
    reactCode={reactCode || ''} 
    svelteCode={svelteCode || ''}
    fullscreen={isFullscreen}
  >
    <div data-fw="react">
      <ReactRouter component={component} example={example} client:only="react" />
    </div>
    <div data-fw="svelte">
      <SvelteRouter component={component} example={example} client:only="svelte" />
    </div>
  </Example>
</div>
