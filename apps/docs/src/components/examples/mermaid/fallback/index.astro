---
// apps/docs/src/components/examples/mermaid/fallback/index.astro
import Example from '../../../Example.astro';
import ReactMermaidFallback from './react.tsx';
import SvelteMermaidFallback from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="fallback" title="Source fallback" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactMermaidFallback client:load />
