---
import Sidebar from './Sidebar.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = import.meta.env.BASE_URL } = Astro.props;
---

<div
  id="mobile-sidebar"
  class="invisible fixed inset-0 z-50 overflow-y-auto bg-background p-6 opacity-0 transition-opacity duration-200"
  data-mobile-sidebar
>
  <div class="mb-6 flex items-center justify-between">
    <span class="flex items-center gap-2 text-lg font-semibold tracking-tight">
      <img
        src={`${import.meta.env.BASE_URL}wicn-logo-light.svg`}
        alt=""
        class="h-7 w-auto dark:hidden"
      />
      <img
        src={`${import.meta.env.BASE_URL}wicn-logo-dark.svg`}
        alt=""
        class="hidden h-7 w-auto dark:block"
      />
      wicn
    </span>
    <button
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-md border border-border text-muted-foreground hover:bg-accent"
      aria-label="Close navigation"
      data-mobile-close
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <Sidebar currentPath={currentPath} />
</div>

<style>
  :global(html.mobile-nav-open) [data-mobile-sidebar] {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-mobile-open]');
  const drawer = document.querySelector<HTMLElement>('[data-mobile-sidebar]');
  const closeBtn = drawer?.querySelector<HTMLButtonElement>('[data-mobile-close]');

  const setBackgroundInert = (inert: boolean) => {
    Array.from(document.body.children)
      .filter((el) => !el.hasAttribute('data-mobile-sidebar'))
      .forEach((el) => (inert ? el.setAttribute('inert', '') : el.removeAttribute('inert')));
  };

  const close = () => {
    document.documentElement.classList.remove('mobile-nav-open');
    openBtn?.setAttribute('aria-expanded', 'false');
    setBackgroundInert(false);
    openBtn?.focus();
  };

  const open = () => {
    document.documentElement.classList.add('mobile-nav-open');
    openBtn?.setAttribute('aria-expanded', 'true');
    setBackgroundInert(true);
    closeBtn?.focus();
  };

  openBtn?.addEventListener('click', () => {
    if (document.documentElement.classList.contains('mobile-nav-open')) close();
    else open();
  });
  closeBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && document.documentElement.classList.contains('mobile-nav-open')) close();
  });
  drawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
</script>
