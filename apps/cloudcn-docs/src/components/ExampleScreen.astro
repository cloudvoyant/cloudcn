---
// apps/cloudcn-docs/src/components/ExampleScreen.astro
// Demo preview wrapper. Padded by default so content (buttons, badges,
// toggles) doesn't hug the card edge. Pass `fullscreen` to render flush for
// demos that emulate a full app screen (e.g. the sidebar).
interface Props {
  /** Render flush to the preview edges (no padding) for full-screen-style demos. */
  fullscreen?: boolean;
  class?: string;
}

const { fullscreen = false, class: className = '' } = Astro.props;
---

<div class={fullscreen ? className : `p-4 ${className}`}>
  <slot />
</div>
