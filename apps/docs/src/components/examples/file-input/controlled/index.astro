---
import Example from '../../../Example.astro';
import ReactFileInputControlled from './react.tsx';
import SvelteFileInputControlled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="controlled" title="Controlled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactFileInputControlled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteFileInputControlled client:load />
  </div>
</Example>
