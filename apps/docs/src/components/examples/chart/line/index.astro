---
// apps/docs/src/components/examples/chart/line/index.astro
import Example from '../../../Example.astro';
import ReactChartLine from './react.tsx';
import SvelteChartLine from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="line" title="Line" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactChartLine client:load />
  </div>
  <div data-fw="svelte">
    <SvelteChartLine client:load />
  </div>
</Example>
