---
// apps/docs/src/components/examples/code-block/multi-file/index.astro
import Example from '../../../Example.astro';
import ReactCodeBlockMultiFile from './react.tsx';
import SvelteCodeBlockMultiFile from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="multi-file" title="Multi-file" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactCodeBlockMultiFile client:load />
  </div>
  <div data-fw="svelte">
    <SvelteCodeBlockMultiFile client:load />
  </div>
</Example>
