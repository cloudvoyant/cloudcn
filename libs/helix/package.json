{
  "name": "@cloudvoyant/helix",
  "version": "0.12.0",
  "description": "helix shared component interfaces, cva variants, and theme",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./src/theme.css",
    "./themes.css": "./src/themes.css",
    "./components.css": "./src/components.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/theme.css",
    "src/themes.css",
    "src/components.css",
    "src/themes"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src tests --no-error-on-unmatched-pattern && tsc --noEmit",
    "lint:fix": "eslint src tests --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
