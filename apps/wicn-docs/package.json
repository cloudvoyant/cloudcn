{
  "name": "wicn-docs",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "wicn docs/demo app — Astro site with React + Svelte component demos",
  "scripts": {
    "predev": "pnpm --filter wicn-core --filter wicn-react --filter wicn-svelte run build",
    "prebuild": "pnpm --filter wicn-core --filter wicn-react --filter wicn-svelte run build",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "e2e": "playwright test",
    "test": "vitest run --passWithNoTests",
    "lint": "astro check && eslint \"src/**/*.{ts,tsx,mjs}\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,mjs}\" --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mjs}\""
  },
  "dependencies": {
    "@astrojs/mdx": "catalog:",
    "@astrojs/react": "catalog:",
    "@astrojs/svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "wicn-core": "workspace:*",
    "wicn-react": "workspace:*",
    "wicn-svelte": "workspace:*",
    "lucide-react": "catalog:",
    "lucide-svelte": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
