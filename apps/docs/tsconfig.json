{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cloudvoyant/vertex-ui": ["../../libs/vertex-ui/src/index.ts"],
      "@cloudvoyant/vertex-react": ["../../libs/vertex-react/src/index.ts"],
      "@cloudvoyant/vertex-svelte": ["../../libs/vertex-svelte/src/index.ts"]
    }
  }
}
