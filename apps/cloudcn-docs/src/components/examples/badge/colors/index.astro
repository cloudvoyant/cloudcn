---
import Example from '../../../Example.astro';
import ReactBadgeColors from './react.tsx';
import SvelteBadgeColors from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example title="Colors" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactBadgeColors client:load />
  </div>
  <div data-fw="svelte">
    <SvelteBadgeColors client:load />
  </div>
</Example>
