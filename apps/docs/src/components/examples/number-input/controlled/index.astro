---
import Example from '../../../Example.astro';
import ReactNumberInputControlled from './react.tsx';
import SvelteNumberInputControlled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="controlled" title="Controlled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactNumberInputControlled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteNumberInputControlled client:load />
  </div>
</Example>
