---
// apps/wicn-docs/src/components/Examples.astro
import Demo from './Demo.astro';

type ComponentName = Parameters<typeof Demo>[0]['component'];
type ExampleName = Parameters<typeof Demo>[0]['example'];

interface Props {
  component?: ComponentName;
  /** The example already shown in the intro — skip it here. */
  exclude?: ExampleName;
}

const { component = 'button', exclude } = Astro.props;

const titles: Record<string, { id: string; title: string }[]> = {
  button: [
    { id: 'outline', title: 'Outline' },
    { id: 'rounded', title: 'Rounded' },
    { id: 'sizes', title: 'Sizes' },
    { id: 'icon', title: 'Icon button' },
    { id: 'with-icon', title: 'With icon' },
    { id: 'disabled', title: 'Disabled' },
  ],
  'toggle-button': [
    { id: 'outline', title: 'Outline' },
    { id: 'icon', title: 'Icon' },
    { id: 'indicator', title: 'Indicator' },
  ],
  badge: [
    { id: 'variants', title: 'Variants' },
    { id: 'colors', title: 'Colors' },
    { id: 'sizes', title: 'Sizes' },
  ],
  layout: [
    { id: 'container-sizes', title: 'Container sizes' },
    { id: 'container-fluid', title: 'Fluid container' },
    { id: 'row', title: 'Row' },
    { id: 'row-gap', title: 'Row with gap' },
    { id: 'row-separator', title: 'Row separator' },
    { id: 'row-responsive', title: 'Row responsive direction' },
    { id: 'col', title: 'Col' },
    { id: 'col-gap', title: 'Col with gap' },
    { id: 'col-separator', title: 'Col separator' },
    { id: 'col-responsive', title: 'Col responsive direction' },
  ],
  stack: [
    { id: 'hstack', title: 'HStack' },
    { id: 'vstack', title: 'VStack' },
    { id: 'separator', title: 'Separator' },
    { id: 'responsive-direction', title: 'Responsive direction' },
  ],
  'scroll': [
    { id: 'sizes', title: 'Sizes' },
    { id: 'horizontal', title: 'Horizontal scrolling' },
    { id: 'both', title: 'Both directions' },
    { id: 'scroll-shadow', title: 'Scroll shadow' },
    { id: 'thumb-styling', title: 'Thumb styling' },
  ],
  splitter: [
    { id: 'vertical', title: 'Vertical' },
    { id: 'multiple-panels', title: 'Multiple panels' },
    { id: 'collapsible', title: 'Collapsible panels' },
    { id: 'min-max', title: 'Min/max constraints' },
    { id: 'disabled', title: 'Disabled resize' },
  ],
  center: [
    { id: 'icon', title: 'Icon' },
    { id: 'inline', title: 'Inline' },
  ],
  item: [{ id: 'in-container', title: 'In a container' }],
  card: [
    { id: 'variants', title: 'Variants' },
    { id: 'sizes', title: 'Sizes' },
    { id: 'override', title: 'Override title' },
    { id: 'with-image', title: 'Cover variants' },
    { id: 'horizontal', title: 'Horizontal' },
  ],
  sidebar: [
    { id: 'icon', title: 'Collapses to an icon rail' },
    { id: 'offcanvas', title: 'Completely disappears on collapse' },
    { id: 'rail', title: 'Toggle with the rail handle' },
  ],
  tabs: [
    { id: 'underline', title: 'Underline' },
  ],
  pagination: [
    { id: 'controlled', title: 'Controlled' },
  ],
  navbar: [
    { id: 'floating', title: 'Floating' },
    { id: 'shrink', title: 'Shrink on scroll' },
    { id: 'scroll', title: 'Scroll' },
    { id: 'hide', title: 'Hide on leave' },
    { id: 'dropdown', title: 'Menu dropdowns' },
    { id: 'two-columns', title: 'Two-column menu' },
    { id: 'density', title: 'Compact menu' },
    { id: 'variants', title: 'Menu links' },
  ],
};
const entries = (titles[component ?? 'button'] ?? []).filter((e) => e.id !== exclude);
---

<div class="flex flex-col gap-10">
  {entries.map((entry) => (
    <section class="flex flex-col gap-3">
      <h3 class="text-lg font-semibold tracking-tight">{entry.title}</h3>
      <Demo component={component} example={entry.id as ExampleName} />
    </section>
  ))}
</div>
