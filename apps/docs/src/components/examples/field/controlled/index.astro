---
import Example from '../../../Example.astro';
import ReactFieldControlled from './react.tsx';
import SvelteFieldControlled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="controlled" title="Controlled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactFieldControlled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteFieldControlled client:load />
  </div>
</Example>
