import SvelteNavbarFloating from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example title="Floating" reactCode={reactCode} svelteCode={svelteCode} fullscreen>
