---
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import Footer from '../components/Footer.astro';
import MobileSidebar from '../components/MobileSidebar.astro';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  headings?: TocHeading[];
}

const {
  title = 'cloudcn',
  description,
  currentPath = '/',
  headings = [] }
= Astro.props;
---

<!doctype html>
<html lang="en" data-framework="react">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        try {
          var framework = localStorage.getItem('cloudcn:framework');
          if (framework === 'svelte' || framework === 'react') {
            document.documentElement.dataset.framework = framework;
          }
          // Restore the theme before first paint to avoid a flash.
          var root = document.documentElement;
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          var mode = localStorage.getItem('cloudcn:color-mode') || 'system';
          var dark = mode === 'dark' || (mode === 'system' && mq.matches);
          if (dark) root.classList.add('dark');
          var theme = localStorage.getItem('cloudcn:theme');
          // Ignore legacy 'light'/'dark' values left by the old theme toggle.
          if (theme && theme !== 'light' && theme !== 'dark') {
            var toRemove = [];
            for (var i = 0; i < root.classList.length; i++) {
              if (root.classList[i].indexOf('theme-') === 0) toRemove.push(root.classList[i]);
            }
            for (var j = 0; j < toRemove.length; j++) root.classList.remove(toRemove[j]);
            root.classList.add('theme-' + theme);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <TopNav currentPath={currentPath} />
    <div class="mx-auto flex w-full max-w-6xl gap-8 px-4 lg:px-8">
      <aside class="hidden w-56 shrink-0 py-10 lg:block">
        <div class="sticky top-24">
          <Sidebar currentPath={currentPath} />
        </div>
      </aside>
      <main class="min-w-0 flex-1 py-10">
        <div class="mx-auto w-full max-w-3xl">
          <slot />
        </div>
      </main>
      <Toc headings={headings} />
    </div>
    <Footer />
    <MobileSidebar currentPath={currentPath} />
  </body>
</html>
