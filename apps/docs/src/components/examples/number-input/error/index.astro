---
import Example from '../../../Example.astro';
import ReactNumberInputError from './react.tsx';
import SvelteNumberInputError from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="error" title="Validation error" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactNumberInputError client:load />
  </div>
  <div data-fw="svelte">
    <SvelteNumberInputError client:load />
  </div>
</Example>
