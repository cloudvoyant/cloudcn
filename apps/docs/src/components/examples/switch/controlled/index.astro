---
import Example from '../../../Example.astro';
import ReactSwitchControlled from './react.tsx';
import SvelteSwitchControlled from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="controlled" title="Controlled" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactSwitchControlled client:load />
  </div>
  <div data-fw="svelte">
    <SvelteSwitchControlled client:load />
  </div>
</Example>
