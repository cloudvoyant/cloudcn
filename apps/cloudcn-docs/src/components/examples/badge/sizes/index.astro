---
import Example from '../../../Example.astro';
import ReactBadgeSizes from './react.tsx';
import SvelteBadgeSizes from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example title="Sizes" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactBadgeSizes client:load />
  </div>
  <div data-fw="svelte">
    <SvelteBadgeSizes client:load />
  </div>
</Example>
