  'window': [
    { id: 'controlled-size', title: 'Controlled size' },
    { id: 'controlled-position', title: 'Controlled position' },
    { id: 'anchor-position', title: 'Anchor position' },
    { id: 'open-state', title: 'Open state' },
    { id: 'lazy-mount', title: 'Lazy mount' },
    { id: 'context', title: 'Context' },
