---
import Sidebar from './Sidebar.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<div
  class="invisible fixed inset-0 z-50 overflow-y-auto bg-background p-6 opacity-0 transition-opacity duration-200"
  data-mobile-sidebar
>
  <div class="mb-6 flex items-center justify-between">
    <span class="text-lg font-semibold tracking-tight">cloudcn</span>
    <button
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-md border border-border text-muted-foreground hover:bg-accent"
      aria-label="Close navigation"
      data-mobile-close
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <Sidebar currentPath={currentPath} />
</div>

<style>
  :global(html.mobile-nav-open) [data-mobile-sidebar] {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const closeBtn = document.querySelector('[data-mobile-close]');
  const close = () => document.documentElement.classList.remove('mobile-nav-open');
  closeBtn?.addEventListener('click', close);

  document.querySelector('[data-mobile-sidebar]')?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', close);
  });
</script>
