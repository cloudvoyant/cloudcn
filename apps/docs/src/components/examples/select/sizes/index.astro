---
import Example from '../../../Example.astro';
import ReactSelectSizes from './react.tsx';
import SvelteSelectSizes from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example id="sizes" title="Sizes" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactSelectSizes client:load />
  </div>
  <div data-fw="svelte">
    <SvelteSelectSizes client:load />
  </div>
</Example>
