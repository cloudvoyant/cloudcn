import ExampleContainerSizes from './examples/container/sizes/index.astro';
import ExampleContainerFluid from './examples/container/fluid/index.astro';
import ExampleRowDefault from './examples/row/default/index.astro';
import ExampleRowWithGap from './examples/row/with-gap/index.astro';
import ExampleRowSeparator from './examples/row/separator/index.astro';
import ExampleRowResponsiveDirection from './examples/row/responsive-direction/index.astro';
import ExampleColDefault from './examples/col/default/index.astro';
import ExampleColWithGap from './examples/col/with-gap/index.astro';
import ExampleColSeparator from './examples/col/separator/index.astro';
import ExampleColResponsiveDirection from './examples/col/responsive-direction/index.astro';
import ExampleStackDefault from './examples/stack/default/index.astro';
import ExampleStackHstack from './examples/stack/hstack/index.astro';
import ExampleStackVstack from './examples/stack/vstack/index.astro';
import ExampleStackSeparator from './examples/stack/separator/index.astro';
import ExampleStackResponsiveDirection from './examples/stack/responsive-direction/index.astro';
import ExampleScrollDefault from './examples/scroll/default/index.astro';
import ExampleScrollSizes from './examples/scroll/sizes/index.astro';
import ExampleScrollHorizontal from './examples/scroll/horizontal/index.astro';
import ExampleScrollBoth from './examples/scroll/both/index.astro';
import ExampleScrollScrollShadow from './examples/scroll/scroll-shadow/index.astro';
import ExampleScrollThumbStyling from './examples/scroll/thumb-styling/index.astro';
import ExampleSplitterDefault from './examples/splitter/default/index.astro';
import ExampleSplitterVertical from './examples/splitter/vertical/index.astro';
import ExampleSplitterMultiplePanels from './examples/splitter/multiple-panels/index.astro';
import ExampleSplitterCollapsible from './examples/splitter/collapsible/index.astro';
import ExampleSplitterMinMax from './examples/splitter/min-max/index.astro';
import ExampleSplitterDisabled from './examples/splitter/disabled/index.astro';
import ExampleCenterDefault from './examples/center/default/index.astro';
import ExampleCenterIcon from './examples/center/icon/index.astro';
import ExampleCenterInline from './examples/center/inline/index.astro';
import ExampleItemInStack from './examples/item/in-stack/index.astro';
import ExampleItemInContainer from './examples/item/in-container/index.astro';
import ExampleCardDefault from './examples/card/default/index.astro';
import ExampleCardVariants from './examples/card/variants/index.astro';
import ExampleCardSizes from './examples/card/sizes/index.astro';
import ExampleCardOverride from './examples/card/override/index.astro';
import ExampleCardWithImage from './examples/card/with-image/index.astro';
import ExampleCardHorizontal from './examples/card/horizontal/index.astro';
import ExampleNavigationMenuDefault from './examples/navigation-menu/default/index.astro';
import ExampleNavigationMenuDropdown from './examples/navigation-menu/dropdown/index.astro';
import ExampleNavigationMenuTwoColumns from './examples/navigation-menu/two-columns/index.astro';
import ExampleTabsDefault from './examples/tabs/default/index.astro';
import ExampleTabsUnderline from './examples/tabs/underline/index.astro';
import ExamplePaginationDefault from './examples/pagination/default/index.astro';
import ExamplePaginationControlled from './examples/pagination/controlled/index.astro';
import ExampleNavbarSticky from './examples/navbar/sticky/index.astro';
import ExampleNavbarFloating from './examples/navbar/floating/index.astro';

type ComponentName =
  | 'button'
  | 'toggle-button'
  | 'badge'
  | 'layout'
  | 'stack'
  | 'scroll'
  | 'splitter'
  | 'center'
  | 'item'
  | 'card'
  | 'sidebar'
  | 'navigation-menu'
  | 'tabs'
  | 'pagination'
  | 'navbar';

type ExampleName =
  | 'solid'
  | 'outline'
  | 'rounded'
  | 'sizes'
  | 'icon'
  | 'with-icon'
  | 'disabled'
  | 'indicator'
  | 'variants'
  | 'colors'
  | 'default'
  | 'fluid'
  | 'hstack'
  | 'vstack'
  | 'separator'
  | 'responsive-direction'
  | 'horizontal'
  | 'both'
  | 'scroll-shadow'
  | 'thumb-styling'
  | 'vertical'
  | 'multiple-panels'
  | 'collapsible'
  | 'min-max'
  | 'container'
  | 'container-sizes'
  | 'container-fluid'
  | 'row'
  | 'row-gap'
  | 'row-separator'
  | 'row-responsive'
  | 'col'
  | 'col-gap'
  | 'col-separator'
  | 'col-responsive'
  | 'inline'
  | 'in-stack'
  | 'in-container'
  | 'override'
  | 'with-image'
  | 'offcanvas'
  | 'rail'
  | 'dropdown'
  | 'two-columns'
  | 'underline'
  | 'controlled'
  | 'sticky'
  | 'floating';

interface ExampleEntry {
  id: ExampleName;
  title: string;
  component: typeof ExampleButtonSolid;
}

interface Props {
  component?: ComponentName;
  /** Render a single example by id (defaults to the first in the registry). */
  example?: ExampleName;
}

const { component = 'button', example } = Astro.props;

const registry: Record<ComponentName, ExampleEntry[]> = {
  button: [
    { id: 'solid', title: 'Solid', component: ExampleButtonSolid },
    { id: 'outline', title: 'Outline', component: ExampleButtonOutline },
    { id: 'rounded', title: 'Rounded', component: ExampleButtonRounded },
    { id: 'sizes', title: 'Sizes', component: ExampleButtonSizes },
    { id: 'icon', title: 'Icon button', component: ExampleButtonIcon },
    { id: 'with-icon', title: 'With icon', component: ExampleButtonWithIcon },
    { id: 'disabled', title: 'Disabled', component: ExampleButtonDisabled },
  ],
  'toggle-button': [
    { id: 'default', title: 'Default', component: ExampleToggleButtonDefault },
    { id: 'outline', title: 'Outline', component: ExampleToggleButtonOutline },
    { id: 'icon', title: 'Icon', component: ExampleToggleButtonIcon },
    { id: 'indicator', title: 'Indicator', component: ExampleToggleButtonIndicator },
  ],
  badge: [
    { id: 'default', title: 'Default', component: ExampleBadgeDefault },
    { id: 'variants', title: 'Variants', component: ExampleBadgeVariants },
    { id: 'colors', title: 'Colors', component: ExampleBadgeColors },
    { id: 'sizes', title: 'Sizes', component: ExampleBadgeSizes },
  ],
  layout: [
    { id: 'container', title: 'Container', component: ExampleContainerDefault },
    { id: 'container-sizes', title: 'Container sizes', component: ExampleContainerSizes },
    { id: 'container-fluid', title: 'Fluid container', component: ExampleContainerFluid },
    { id: 'row', title: 'Row', component: ExampleRowDefault },
    { id: 'row-gap', title: 'Row with gap', component: ExampleRowWithGap },
    { id: 'row-separator', title: 'Row separator', component: ExampleRowSeparator },
    { id: 'row-responsive', title: 'Row responsive direction', component: ExampleRowResponsiveDirection },
    { id: 'col', title: 'Col', component: ExampleColDefault },
    { id: 'col-gap', title: 'Col with gap', component: ExampleColWithGap },
    { id: 'col-separator', title: 'Col separator', component: ExampleColSeparator },
    { id: 'col-responsive', title: 'Col responsive direction', component: ExampleColResponsiveDirection },
  ],
  stack: [
    { id: 'default', title: 'Default', component: ExampleStackDefault },
    { id: 'hstack', title: 'HStack', component: ExampleStackHstack },
    { id: 'vstack', title: 'VStack', component: ExampleStackVstack },
    { id: 'separator', title: 'Separator', component: ExampleStackSeparator },
    { id: 'responsive-direction', title: 'Responsive direction', component: ExampleStackResponsiveDirection },
  ],
  'scroll': [
    { id: 'default', title: 'Default', component: ExampleScrollDefault },
    { id: 'sizes', title: 'Sizes', component: ExampleScrollSizes },
    { id: 'horizontal', title: 'Horizontal scrolling', component: ExampleScrollHorizontal },
    { id: 'both', title: 'Both directions', component: ExampleScrollBoth },
    { id: 'scroll-shadow', title: 'Scroll shadow', component: ExampleScrollScrollShadow },
    { id: 'thumb-styling', title: 'Thumb styling', component: ExampleScrollThumbStyling },
  ],
  splitter: [
    { id: 'default', title: 'Default', component: ExampleSplitterDefault },
    { id: 'vertical', title: 'Vertical', component: ExampleSplitterVertical },
    { id: 'multiple-panels', title: 'Multiple panels', component: ExampleSplitterMultiplePanels },
    { id: 'collapsible', title: 'Collapsible panels', component: ExampleSplitterCollapsible },
    { id: 'min-max', title: 'Min/max constraints', component: ExampleSplitterMinMax },
    { id: 'disabled', title: 'Disabled resize', component: ExampleSplitterDisabled },
  ],
  center: [
    { id: 'default', title: 'Default', component: ExampleCenterDefault },
    { id: 'icon', title: 'Icon', component: ExampleCenterIcon },
    { id: 'inline', title: 'Inline', component: ExampleCenterInline },
  ],
  item: [
    { id: 'in-stack', title: 'In a stack', component: ExampleItemInStack },
    { id: 'in-container', title: 'In a container', component: ExampleItemInContainer },
  ],
  card: [
    { id: 'default', title: 'Default', component: ExampleCardDefault },
    { id: 'variants', title: 'Variants', component: ExampleCardVariants },
    { id: 'sizes', title: 'Sizes', component: ExampleCardSizes },
    { id: 'override', title: 'Override title', component: ExampleCardOverride },
    { id: 'with-image', title: 'With image', component: ExampleCardWithImage },
    { id: 'horizontal', title: 'Horizontal', component: ExampleCardHorizontal },
  ],
  sidebar: [
    { id: 'icon', title: 'Collapses to an icon rail', component: ExampleSidebarIcon },
    { id: 'offcanvas', title: 'Completely disappears on collapse', component: ExampleSidebarOffcanvas },
    { id: 'rail', title: 'Toggle with the rail handle', component: ExampleSidebarRail },
  ],
  'navigation-menu': [
    { id: 'default', title: 'Default', component: ExampleNavigationMenuDefault },
    { id: 'dropdown', title: 'Dropdown panels', component: ExampleNavigationMenuDropdown },
    { id: 'two-columns', title: 'Two columns', component: ExampleNavigationMenuTwoColumns },
  ],
  tabs: [
    { id: 'default', title: 'Default', component: ExampleTabsDefault },
    { id: 'underline', title: 'Underline', component: ExampleTabsUnderline },
  ],
  pagination: [
    { id: 'default', title: 'Default', component: ExamplePaginationDefault },
    { id: 'controlled', title: 'Controlled', component: ExamplePaginationControlled },
  ],
  navbar: [
    { id: 'sticky', title: 'Sticky', component: ExampleNavbarSticky },
    { id: 'floating', title: 'Floating', component: ExampleNavbarFloating },
  ],
};

const entries = registry[component] ?? [];
const selected = example ? entries.find((e) => e.id === example) ?? entries[0] : entries[0];
---

<div class="w-full" data-demo-region>
  {selected && <selected.component />}
</div>
