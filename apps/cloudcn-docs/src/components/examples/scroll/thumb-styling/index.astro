import SvelteScrollThumbStyling from './svelte.svelte';
import reactCode from './react.tsx?raw';
import svelteCode from './svelte.svelte?raw';
---

<Example title="Thumb styling" reactCode={reactCode} svelteCode={svelteCode}>
  <div data-fw="react">
    <ReactScrollThumbStyling client:load />
