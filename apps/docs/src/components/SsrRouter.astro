---
interface Props {
  component: string;
  example: string;
}
const { component, example } = Astro.props;

const reactModules = import.meta.glob('./examples/*/*/react.tsx', { eager: true });
const svelteModules = import.meta.glob('./examples/*/*/svelte.svelte', { eager: true });

const reactPath = `./examples/${component}/${example}/react.tsx`;
const sveltePath = `./examples/${component}/${example}/svelte.svelte`;

const ReactComp = reactModules[reactPath]?.default;
const SvelteComp = svelteModules[sveltePath]?.default;
---
<div data-fw="react">
  {ReactComp ? <ReactComp /> : <div>React example not found</div>}
</div>
<div data-fw="svelte">
  {SvelteComp ? <SvelteComp /> : <div>Svelte example not found</div>}
</div>
